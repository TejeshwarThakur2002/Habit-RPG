{
  "name": "habit-rpg",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @habit-rpg/mobile start",
    "ios": "pnpm --filter @habit-rpg/mobile ios",
    "android": "pnpm --filter @habit-rpg/mobile android",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @habit-rpg/mobile e2e",
    "functions:shared": "node scripts/copy-functions-shared.mjs",
    "functions:check": "node scripts/copy-functions-shared.mjs --check && deno lint supabase/functions && deno check --config supabase/functions/tests/deno.json supabase/functions",
    "functions:test": "deno test --allow-read --config supabase/functions/tests/deno.json supabase/functions/tests",
    "prepare": "husky",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "2.120.0"
  }
}
