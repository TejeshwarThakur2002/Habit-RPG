# Every environment variable the project uses (SCOPE.md section 7).
# Copy the app section to apps/mobile/.env for local development. Never commit real values:
# .gitignore blocks every .env file except this one.

# ---- App (apps/mobile/.env) ----------------------------------------------------------------
# Public by design: these ship inside the app and are protected by Row Level Security.
# Local stack: run `pnpm supabase:start`; it prints the API URL and the publishable key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional crash reporting (P6).
SENTRY_DSN=

# ---- Server only: Edge Function secrets, never in the app or this repo -----------------------
# Set with `supabase secrets set` on the hosted project. The local stack injects its own.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret between pg_cron and the daily-tick function (D40). Locally,
# `pnpm functions:serve` writes a random one to supabase/functions/.env.
CRON_SECRET=

# ---- CI only: GitHub Actions secrets ------------------------------------------------------
EAS_TOKEN=
SUPABASE_ACCESS_TOKEN=
